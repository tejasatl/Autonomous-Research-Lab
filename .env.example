# ==============================================================================
# Autonomous Research Lab (ARL) - Environment Configuration
# Copy this file to .env and configure your preferences:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Selection
# Options: 'gemini' | 'local' | 'groq' | 'openai'
# ------------------------------------------------------------------------------
LLM_BACKEND=gemini

# Google Gemini API Key (Get free key from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Optional - Get free key from: https://console.groq.com/)
# GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional)
# OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Server & Security Settings
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=True
SECRET_KEY=AUTONOMOUS_RESEARCH_LAB_PRODUCTION_SECRET_KEY_REPLACE_ME_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. Frontend Web URL (For CORS policies)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Graph Database (Neo4j) Settings
# Optional: The system automatically falls back to local high-speed JSON graphs
# if Neo4j is offline or not installed.
# ------------------------------------------------------------------------------
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password