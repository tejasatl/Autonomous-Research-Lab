# ==============================
# Generated Data & Large Artifacts
# (Directories preserved via .gitkeep)
# ==============================
data/pdfs/*.pdf
data/embeddings/*.json
data/chunks/*.json
data/proposals/*.pdf
data/proposals/*.tex
data/proposals/*.md
data/hypotheses/*.md
data/gaps/*.md
data/validations/*.md
data/reports/*.md
memory/research_cycles/*.json

# Ensure .gitkeep files are always tracked
!**/.gitkeep

